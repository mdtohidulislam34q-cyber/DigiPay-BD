<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DigiPay BD - Official Platform</title>
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;600;700&family=Outfit:wght@400;600;700;800;900&family=Tiro+Bangla&display=swap" rel="stylesheet">
    
    <style>
        /* =======================================================
           --- THEME VARIABLES (Default: Light Mode) ---
           ======================================================= */
        :root {
            --bg-page: #f1f5f9;
            --bg-gradient: linear-gradient(-45deg, #f8fafc, #e2e8f0, #e0f2fe, #fae8ff);
            --card-bg: rgba(255, 255, 255, 0.96);
            --card-border: rgba(0, 0, 0, 0.08);
            --neon-blue: #0088ff;
            --neon-purple: #8a2be2;
            --neon-pink: #ff007f;
            --text-main: #0f172a;
            --text-sub: #64748b;
            --success: #10b981;
            --warning: #f59e0b;
            --header-bg: rgba(255, 255, 255, 0.95);
            --header-border: rgba(0, 0, 0, 0.08);
            --header-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            --notice-bg: rgba(0, 136, 255, 0.08);
            --notice-border: rgba(0, 136, 255, 0.18);
            --notice-color: #0284c7;
            --dock-bg: rgba(255, 255, 255, 0.92);
            --dock-border: rgba(0, 0, 0, 0.1);
            --dock-shadow: 0 15px 35px rgba(0, 0, 0, 0.12), 0 0 20px rgba(0, 136, 255, 0.15);
            --sidebar-bg: rgba(255, 255, 255, 0.98);
            --subscreen-bg: #f8fafc;
            --profile-inner-bg: #ffffff;
            --quick-btn-bg: rgba(0, 0, 0, 0.04);
            --quick-btn-border: rgba(0, 0, 0, 0.08);
            --quick-btn-color: #0f172a;
            --back-btn-bg: rgba(0, 0, 0, 0.06);
            --back-btn-border: rgba(0, 0, 0, 0.1);
            --back-btn-color: #0f172a;
            --referral-inner-bg: #ffffff;
            --referral-flex-bg: #e2e8f0;
            --coming-soon-bg: #ffffff;
            --service-title-color: #334155;
            --menu-item-color: #1e293b;
            --menu-arrow-color: #94a3b8;
        }

        /* --- Dark Mode Overrides --- */
        body.dark-mode {
            --bg-page: #02040a;
            --bg-gradient: linear-gradient(-45deg, #02040a, #0d021a, #001026, #180015);
            --card-bg: rgba(13, 18, 30, 0.85);
            --card-border: rgba(255, 255, 255, 0.08);
            --neon-blue: #00d2ff;
            --neon-purple: #8a2be2;
            --neon-pink: #ff007f;
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
            --header-bg: rgba(5, 8, 16, 0.95);
            --header-border: rgba(255, 255, 255, 0.08);
            --header-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
            --notice-bg: rgba(0, 210, 255, 0.06);
            --notice-border: rgba(0, 210, 255, 0.15);
            --notice-color: #38bdf8;
            --dock-bg: rgba(10, 15, 29, 0.88);
            --dock-border: rgba(255, 255, 255, 0.12);
            --dock-shadow: 0 15px 35px rgba(0, 0, 0, 0.85), 0 0 20px rgba(0, 210, 255, 0.15);
            --sidebar-bg: rgba(5, 8, 16, 0.98);
            --subscreen-bg: #02040a;
            --profile-inner-bg: #080d1a;
            --quick-btn-bg: rgba(255, 255, 255, 0.05);
            --quick-btn-border: rgba(255, 255, 255, 0.1);
            --quick-btn-color: #ffffff;
            --back-btn-bg: rgba(255, 255, 255, 0.08);
            --back-btn-border: rgba(255, 255, 255, 0.08);
            --back-btn-color: #ffffff;
            --referral-inner-bg: rgba(6, 9, 18, 0.95);
            --referral-flex-bg: rgba(0, 0, 0, 0.5);
            --coming-soon-bg: #060a14;
            --service-title-color: #cbd5e1;
            --menu-item-color: #cbd5e1;
            --menu-arrow-color: #64748b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Outfit', 'Hind Siliguri', sans-serif;
            -webkit-tap-highlight-color: transparent;
            transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
        }

        body {
            background-color: var(--bg-page);
            color: var(--text-main);
            padding-bottom: 100px;
            overflow-x: hidden;
            background: var(--bg-gradient);
            background-size: 400% 400%;
            animation: deepBG 12s ease infinite;
        }

        @keyframes deepBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* --- Click Ripple Animation --- */
        .ripple {
            position: relative;
            overflow: hidden;
        }

        .ripple-effect {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.35);
            transform: scale(0);
            animation: rippleAnim 0.5s linear;
            pointer-events: none;
        }

        @keyframes rippleAnim {
            to { transform: scale(4); opacity: 0; }
        }

        /* --- Header & Brand --- */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 16px;
            background: var(--header-bg);
            backdrop-filter: blur(15px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--header-border);
            box-shadow: var(--header-shadow);
        }

        .header-left { display: flex; align-items: center; gap: 10px; }
        .header-right { display: flex; align-items: center; gap: 10px; }

        .menu-icon-btn {
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--neon-blue);
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(0, 136, 255, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0, 136, 255, 0.25);
        }

        .theme-toggle-btn {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: rgba(0, 136, 255, 0.1);
            border: 1px solid rgba(0, 136, 255, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--neon-blue);
            font-size: 1.15rem;
            box-shadow: 0 0 10px rgba(0, 136, 255, 0.15);
            transition: 0.3s ease;
        }

        .theme-toggle-btn:active {
            transform: scale(0.92);
        }

        body.dark-mode .theme-toggle-btn {
            color: #fbbf24;
            background: rgba(251, 191, 36, 0.12);
            border-color: rgba(251, 191, 36, 0.3);
            box-shadow: 0 0 12px rgba(251, 191, 36, 0.35);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .custom-logo {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-pink));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            color: #fff;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.5);
            flex-shrink: 0;
        }

        .brand-separator {
            width: 2px;
            height: 26px;
            background: linear-gradient(to bottom, transparent, var(--neon-blue), transparent);
            border-radius: 2px;
        }

        /* DIGI PAY এবং BD একদম কাছে লাগানো */
        .brand-text-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: flex-start;
            gap: 4px;
            line-height: 1;
        }

        .brand-main {
            font-size: 1.3rem;
            font-weight: 900;
            letter-spacing: 0.3px;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            background: linear-gradient(90deg, #1e293b, var(--neon-blue), var(--neon-pink), #1e293b);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shineText 4s linear infinite;
            filter: drop-shadow(0 0 8px rgba(0, 136, 255, 0.4));
        }

        body.dark-mode .brand-main {
            background: linear-gradient(90deg, #ffffff, var(--neon-blue), var(--neon-pink), #ffffff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 8px rgba(0, 210, 255, 0.6));
        }

        .brand-sub {
            font-size: 0.65rem;
            font-weight: 900;
            color: #ffffff;
            background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple));
            padding: 2.5px 6px;
            border-radius: 6px;
            letter-spacing: 0.5px;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
            text-transform: uppercase;
        }

        @keyframes shineText {
            to { background-position: 200% center; }
        }

        .profile-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--neon-purple), var(--neon-blue));
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 2px solid var(--neon-blue);
            box-shadow: 0 0 12px rgba(0, 210, 255, 0.4);
            color: #fff;
        }

        /* --- Ticker Notification --- */
        .notice-ticker {
            background: var(--notice-bg);
            border-bottom: 1px solid var(--notice-border);
            color: var(--notice-color);
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
        }

        .live-badge {
            background: linear-gradient(135deg, #ff0055, #ff0000);
            color: white;
            font-size: 0.65rem;
            padding: 3px 8px;
            border-radius: 20px;
            font-weight: bold;
            box-shadow: 0 0 10px rgba(255, 0, 85, 0.7);
            animation: pulse 1.5s infinite;
        }

        /* --- Banner Image --- */
        .banner-container {
            margin: 15px;
            border-radius: 20px;
            padding: 1.5px;
            background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple), var(--neon-blue));
            background-size: 300% 300%;
            animation: deepBG 6s ease infinite;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        }

        .banner-box {
            height: 180px;
            border-radius: 18px;
            background: #090d18 url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1000&auto=format&fit=crop') center/cover no-repeat;
            display: flex;
            align-items: flex-end;
            position: relative;
            overflow: hidden;
        }

        .banner-overlay {
            width: 100%;
            padding: 15px;
            background: linear-gradient(to top, rgba(2, 4, 10, 0.95), transparent);
            color: #fff;
        }

        .banner-title { font-size: 1.1rem; font-weight: 800; color: #00d2ff; }
        .banner-desc { font-size: 0.8rem; color: #cbd5e1; }

        /* --- Verify Account Box (Dashboard) --- */
        .verify-large-box {
            margin: 0 15px 22px 15px;
            padding: 18px 20px;
            border-radius: 16px;
            background: linear-gradient(135deg, rgba(255, 0, 127, 0.15), rgba(138, 43, 226, 0.25));
            border: 1.5px solid var(--neon-pink);
            box-shadow: 0 8px 25px rgba(255, 0, 127, 0.2);
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
        }

        .verify-large-box h3 {
            font-family: 'Tiro Bangla', 'Hind Siliguri', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            letter-spacing: 0.5px;
        }

        body.dark-mode .verify-large-box h3 {
            color: #ffffff;
        }

        .verify-large-box:active { transform: scale(0.97); }

        /* --- Section Titles --- */
        .section-title {
            margin: 18px 15px 12px 15px;
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--text-sub);
            letter-spacing: 1px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-title::before {
            content: '';
            width: 4px;
            height: 16px;
            background: var(--neon-pink);
            border-radius: 4px;
            box-shadow: 0 0 10px var(--neon-pink);
        }

        /* --- Social Grid --- */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            margin: 0 15px 20px 15px;
        }

        .social-card {
            position: relative;
            padding: 14px 0;
            border-radius: 14px;
            text-align: center;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
            z-index: 1;
            transition: transform 0.2s ease;
        }

        .social-card::before {
            content: '';
            position: absolute;
            inset: -1.5px;
            border-radius: 15.5px;
            background: linear-gradient(0deg, var(--neon-blue), var(--neon-purple), var(--neon-pink), var(--neon-blue));
            background-size: 300% 300%;
            animation: rotateProfileBorder 4s linear infinite;
            z-index: -2;
            box-shadow: 0 0 6px rgba(0, 210, 255, 0.22);
        }

        .social-card::after {
            content: '';
            position: absolute;
            inset: 0.5px;
            border-radius: 13.5px;
            background: var(--card-bg);
            z-index: -1;
            transition: background 0.3s ease;
        }

        .social-card i { 
            font-size: 2rem; 
            position: relative;
            z-index: 2;
        }

        .social-card:active { transform: scale(0.95); }

        /* --- Services Grid --- */
        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin: 0 15px 25px 15px;
        }

        .service-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            text-align: center;
        }

        .service-circle {
            position: relative;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 6px;
            box-shadow: 0 3px 12px rgba(0, 210, 255, 0.18);
            transition: 0.2s;
            z-index: 1;
        }

        .service-circle::before {
            content: '';
            position: absolute;
            inset: -1.5px;
            border-radius: 50%;
            background: linear-gradient(0deg, var(--neon-blue), var(--neon-purple), var(--neon-pink), var(--neon-blue));
            background-size: 300% 300%;
            animation: rotateProfileBorder 4s linear infinite;
            z-index: -2;
            box-shadow: 0 0 6px rgba(0, 210, 255, 0.25);
        }

        .service-circle::after {
            content: '';
            position: absolute;
            inset: 0.5px;
            border-radius: 50%;
            background: var(--card-bg);
            z-index: -1;
            transition: background 0.3s ease;
        }

        .service-circle i {
            font-size: 1.3rem;
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            z-index: 2;
        }

        .service-title {
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--service-title-color);
            line-height: 1.1;
        }

        .service-card:active .service-circle { transform: scale(0.92); }

        /* --- Referral Link Box --- */
        .referral-container {
            margin: 0 15px 25px 15px;
            padding: 1.5px;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple), var(--neon-pink));
            background-size: 300% 300%;
            animation: deepBG 6s ease infinite;
        }

        .referral-inner {
            background: var(--referral-inner-bg);
            border-radius: 16px;
            padding: 15px;
        }

        .referral-title {
            font-size: 0.75rem;
            color: var(--text-sub);
            margin-bottom: 8px;
            text-align: center;
        }

        .referral-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--referral-flex-bg);
            border-radius: 10px;
            padding: 8px 12px;
            border: 1px solid var(--card-border);
        }

        .referral-flex code {
            font-size: 0.8rem;
            color: var(--neon-blue);
            font-weight: 700;
        }

        .copy-btn {
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple));
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* --- FOOTER NAVIGATION DOCK --- */
        .bottom-nav {
            position: fixed;
            bottom: 12px; 
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 24px);
            max-width: 480px;
            height: 70px;
            background: var(--dock-bg);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            display: flex;
            justify-content: space-around;
            align-items: center;
            border: 1px solid var(--dock-border);
            border-radius: 26px;
            z-index: 2500;
            box-shadow: var(--dock-shadow);
            padding: 0 6px;
            user-select: none;
        }

        .nav-item {
            position: relative;
            flex: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-sub);
            cursor: pointer;
            gap: 4px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            border-radius: 18px;
            z-index: 10;
        }

        .nav-item > * { pointer-events: none; }

        .nav-icon-wrapper {
            position: relative;
            width: 42px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .nav-item i {
            font-size: 1.35rem;
            transition: all 0.3s ease;
            color: var(--text-sub);
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));
        }

        .nav-label {
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.2px;
            transition: all 0.3s ease;
            color: var(--text-sub);
        }

        .active-indicator {
            position: absolute;
            top: 2px;
            width: 20px;
            height: 3px;
            background: linear-gradient(90deg, var(--neon-blue), var(--neon-pink));
            border-radius: 10px;
            box-shadow: 0 0 12px var(--neon-blue), 0 0 6px var(--neon-pink);
            opacity: 0;
            transform: scaleX(0);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            pointer-events: none;
        }

        .nav-item.active { color: var(--text-main); }

        .nav-item.active .nav-icon-wrapper {
            transform: translateY(-5px);
            background: linear-gradient(135deg, rgba(0, 136, 255, 0.18), rgba(255, 0, 127, 0.18));
            border: 1px solid rgba(0, 136, 255, 0.4);
            box-shadow: 0 6px 18px rgba(0, 136, 255, 0.3);
        }

        .nav-item.active i {
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-pink));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 8px var(--neon-blue));
        }

        .nav-item.active .nav-label {
            color: var(--neon-blue);
            font-weight: 800;
            text-shadow: 0 0 8px rgba(0, 136, 255, 0.5);
        }

        .nav-item.active .active-indicator {
            opacity: 1;
            transform: scaleX(1);
        }

        .nav-item:active { transform: scale(0.92); }

        .nav-item.center-shop-wrap {
            position: relative;
            flex: 0 0 64px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            margin-top: -28px;
            height: calc(100% + 28px);
            z-index: 2600;
            cursor: pointer;
        }

        .center-fab-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--neon-pink), var(--neon-purple), var(--neon-blue));
            background-size: 200% 200%;
            animation: deepBG 4s ease infinite;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            border: 3.5px solid var(--dock-bg);
            box-shadow: 0 8px 25px rgba(255, 0, 127, 0.5), 0 0 20px rgba(0, 136, 255, 0.4);
            cursor: pointer;
            position: relative;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            pointer-events: none;
        }

        .center-fab-btn i {
            font-size: 1.45rem;
            color: #ffffff !important;
            -webkit-text-fill-color: initial !important;
            filter: drop-shadow(0 2px 5px rgba(0,0,0,0.4));
            transition: transform 0.3s ease;
        }

        .center-fab-btn::before {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 1.5px solid var(--neon-pink);
            opacity: 0.8;
            animation: fabPulse 2s infinite ease-out;
            pointer-events: none;
        }

        @keyframes fabPulse {
            0% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.2); opacity: 0.1; }
            100% { transform: scale(1); opacity: 0.8; }
        }

        .center-shop-wrap .nav-label {
            margin-top: 4px;
            font-size: 0.68rem;
            font-weight: 800;
            color: var(--neon-pink);
            letter-spacing: 0.3px;
            text-shadow: 0 0 8px rgba(255, 0, 127, 0.4);
            pointer-events: none;
        }

        .center-shop-wrap.active .center-fab-btn {
            transform: translateY(-2px) scale(1.1);
            box-shadow: 0 0 35px rgba(255, 0, 127, 0.95), 0 0 25px rgba(0, 136, 255, 0.85);
        }

        .center-shop-wrap:active .center-fab-btn { transform: scale(0.92); }

        /* --- Sidebar Drawer --- */
        .sidebar-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            z-index: 2999;
            display: none;
        }

        .sidebar {
            position: fixed;
            top: 0; left: -320px;
            width: 310px; height: 100%;
            background: var(--sidebar-bg);
            backdrop-filter: blur(20px);
            z-index: 3000;
            transition: left 0.3s ease;
            overflow-y: auto;
            padding: 20px 16px;
            box-shadow: 10px 0 35px rgba(0, 0, 0, 0.5);
            border-right: 1px solid var(--card-border);
        }

        .sidebar.active { left: 0; }

        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--card-border);
        }

        .sidebar-title {
            font-size: 1.25rem;
            font-weight: 900;
            letter-spacing: 0.5px;
            background: linear-gradient(90deg, #1e293b, var(--neon-blue), var(--neon-pink), #1e293b);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: shineText 4s linear infinite;
            filter: drop-shadow(0 0 8px rgba(0, 136, 255, 0.4));
            display: flex;
            align-items: center;
            gap: 10px;
        }

        body.dark-mode .sidebar-title {
            background: linear-gradient(90deg, #ffffff, var(--neon-blue), var(--neon-pink), #ffffff);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-title i {
            -webkit-text-fill-color: initial;
            color: var(--neon-blue);
        }

        .close-sidebar-btn {
            width: 35px; height: 35px;
            border-radius: 50%;
            background: var(--back-btn-bg);
            border: 1px solid var(--back-btn-border);
            color: var(--text-main);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer;
        }

        /* =======================================================
           --- ULTRA UNIQUE & FUTURISTIC PROFILE CARD IN SIDEBAR ---
           ======================================================= */
        .user-profile-card {
            position: relative;
            border-radius: 24px;
            padding: 2px;
            margin-bottom: 22px;
            background: linear-gradient(0deg, var(--neon-blue), var(--neon-purple), var(--neon-pink), var(--neon-blue));
            background-size: 300% 300%;
            animation: rotateProfileBorder 4s linear infinite;
            box-shadow: 0 10px 30px rgba(0, 136, 255, 0.22), 0 0 20px rgba(255, 0, 127, 0.18);
            overflow: hidden;
        }

        @keyframes rotateProfileBorder {
            0% { background-position: 0% 0%; }
            50% { background-position: 100% 100%; }
            100% { background-position: 0% 0%; }
        }

        .user-profile-inner {
            background: var(--profile-inner-bg);
            border-radius: 22px;
            padding: 22px 14px 18px 14px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* কার্ডের ভিতর অ্যানিমেটেড হোলোগ্রাফিক আলো ছড়িয়ে যাওয়া */
        .card-shimmer-sweep {
            position: absolute;
            top: -50%;
            left: -60%;
            width: 220%;
            height: 220%;
            background: linear-gradient(
                60deg,
                transparent 42%,
                rgba(255, 255, 255, 0.15) 50%,
                transparent 58%
            );
            transform: rotate(25deg);
            animation: shimmerSweep 6s infinite;
            pointer-events: none;
            z-index: 1;
        }

        body.dark-mode .card-shimmer-sweep {
            background: linear-gradient(
                60deg,
                transparent 42%,
                rgba(0, 210, 255, 0.12) 50%,
                transparent 58%
            );
        }

        @keyframes shimmerSweep {
            0% { transform: translateX(-100%) rotate(25deg); }
            25%, 100% { transform: translateX(100%) rotate(25deg); }
        }

        /* ব্যাকগ্রাউন্ড অ্যাম্বিয়েন্ট গ্লোয়িং লাইট বল */
        .profile-bg-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(28px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.3;
            animation: floatOrb 7s ease-in-out infinite alternate;
        }

        .orb-1 {
            width: 100px;
            height: 100px;
            background: var(--neon-blue);
            top: -25px;
            left: -20px;
        }

        .orb-2 {
            width: 90px;
            height: 90px;
            background: var(--neon-pink);
            bottom: -20px;
            right: -20px;
            animation-delay: -3.5s;
        }

        @keyframes floatOrb {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(18px, 18px) scale(1.2); }
        }

        /* Avatar Container with glowing aura & orbital ring */
        .user-avatar-wrap {
            position: relative;
            width: 78px;
            height: 78px;
            margin: 4px auto 14px auto;
            z-index: 2;
        }

        /* ভাসমান গোল্ডেন ভিআইপি ক্রাউন */
        .vip-crown-badge {
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #f59e0b, #fbbf24, #d97706);
            color: #ffffff;
            font-size: 0.6rem;
            font-weight: 900;
            padding: 2.5px 8px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.55);
            letter-spacing: 0.6px;
            animation: crownFloat 2.6s ease-in-out infinite;
            z-index: 6;
            white-space: nowrap;
        }

        @keyframes crownFloat {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-3.5px); }
        }

        /* অবতারের চারপাশের ঘূর্ণায়মান অরবিট রিং */
        .avatar-orbit-ring {
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 1.5px dashed rgba(0, 210, 255, 0.5);
            animation: spinOrbit 12s linear infinite;
            pointer-events: none;
            z-index: 1;
        }

        .orbiting-dot {
            position: absolute;
            top: -4px;
            left: 50%;
            transform: translateX(-50%);
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--neon-pink);
            box-shadow: 0 0 10px var(--neon-pink), 0 0 16px var(--neon-blue);
        }

        @keyframes spinOrbit {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .user-avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple), var(--neon-pink));
            background-size: 200% 200%;
            animation: deepBG 6s ease infinite, avatarPulseGlow 3s ease-in-out infinite alternate;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.15rem;
            color: #fff;
            border: 3px solid var(--profile-inner-bg);
            box-shadow: 0 0 20px rgba(0, 136, 255, 0.45), 0 4px 15px rgba(0, 0, 0, 0.15);
            transition: transform 0.3s ease;
            position: relative;
            z-index: 2;
        }

        @keyframes avatarPulseGlow {
            0% { box-shadow: 0 0 15px rgba(0, 136, 255, 0.4), 0 0 5px rgba(255, 0, 127, 0.3); }
            100% { box-shadow: 0 0 26px rgba(255, 0, 127, 0.65), 0 0 16px rgba(0, 210, 255, 0.7); }
        }

        .user-avatar:hover { transform: scale(1.05); }

        /* ভেরিফাইড ও আনভেরিফাইড ব্যাজ */
        .avatar-verified-dot {
            position: absolute;
            bottom: 0px;
            right: 0px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #10b981;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            border: 2.5px solid var(--profile-inner-bg);
            box-shadow: 0 0 12px rgba(16, 185, 129, 0.8);
            z-index: 4;
            animation: pulseVerified 2s infinite;
        }

        .avatar-verified-dot.unverified {
            background: #ef4444 !important;
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.8) !important;
            animation: pulseUnverified 2s infinite !important;
        }

        @keyframes pulseVerified {
            0%, 100% { transform: scale(1); box-shadow: 0 0 10px rgba(16, 185, 129, 0.7); }
            50% { transform: scale(1.1); box-shadow: 0 0 18px rgba(16, 185, 129, 0.95); }
        }

        @keyframes pulseUnverified {
            0%, 100% { transform: scale(1); box-shadow: 0 0 10px rgba(239, 68, 68, 0.7); }
            50% { transform: scale(1.1); box-shadow: 0 0 18px rgba(239, 68, 68, 0.95); }
        }

        /* User Name & Status Badge */
        .profile-name-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin-bottom: 4px;
            position: relative;
            z-index: 2;
        }

        .profile-user-name {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: 0.3px;
        }

        .name-sparkle {
            color: #f59e0b;
            font-size: 0.9rem;
            animation: spinSparkle 3s ease-in-out infinite;
        }

        @keyframes spinSparkle {
            0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.8; }
            50% { transform: scale(1.3) rotate(180deg); opacity: 1; filter: drop-shadow(0 0 8px #f59e0b); }
        }

        .profile-role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(0, 136, 255, 0.12));
            color: #10b981;
            border: 1px solid rgba(16, 185, 129, 0.35);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 800;
            margin-bottom: 14px;
            letter-spacing: 0.2px;
            box-shadow: 0 0 10px rgba(16, 185, 129, 0.2);
            position: relative;
            z-index: 2;
        }

        .profile-role-badge i {
            animation: pulseGem 2s infinite;
        }

        @keyframes pulseGem {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 2px #10b981); }
            50% { transform: scale(1.25); filter: drop-shadow(0 0 8px #10b981); }
        }

        /* --- প্রিমিয়াম মিনি স্ট্যাটাস ড্যাশবোর্ড বার --- */
        .profile-mini-stats {
            display: flex;
            align-items: center;
            justify-content: space-around;
            background: rgba(0, 136, 255, 0.05);
            border: 1px solid rgba(0, 136, 255, 0.14);
            border-radius: 14px;
            padding: 8px 6px;
            margin-bottom: 12px;
            backdrop-filter: blur(10px);
            position: relative;
            z-index: 2;
        }

        body.dark-mode .profile-mini-stats {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .stat-mini-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            flex: 1;
        }

        .stat-mini-label {
            font-size: 0.66rem;
            color: var(--text-sub);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .stat-mini-val {
            font-size: 0.88rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: 0.3px;
        }

        .stat-mini-divider {
            width: 1px;
            height: 22px;
            background: var(--card-border);
        }

        /* --- সাইবার স্টাইলিশ অ্যাফিলিয়েট আইডি বক্স --- */
        .affiliate-id-box {
            position: relative;
            background: var(--quick-btn-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.03);
            transition: border-color 0.3s ease;
            overflow: hidden;
            z-index: 2;
        }

        .affiliate-id-box:hover {
            border-color: rgba(0, 136, 255, 0.4);
        }

        .affiliate-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .affiliate-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .affiliate-label i {
            color: var(--neon-blue);
            font-size: 0.85rem;
        }

        .affiliate-status-tag {
            font-size: 0.65rem;
            color: #10b981;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(16, 185, 129, 0.12);
            padding: 1px 7px;
            border-radius: 10px;
        }

        .affiliate-status-tag i {
            font-size: 0.55rem;
            animation: blinkDot 1.5s infinite;
        }

        @keyframes blinkDot {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        .affiliate-code-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--profile-inner-bg);
            border: 1.5px dashed rgba(0, 136, 255, 0.45);
            border-radius: 12px;
            padding: 6px 8px 6px 12px;
            transition: all 0.3s ease;
        }

        .code-with-icon {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .code-badge-icon {
            color: var(--neon-pink);
            font-size: 1.1rem;
            filter: drop-shadow(0 0 6px rgba(255, 0, 127, 0.5));
            animation: pulseIcon 3s infinite;
        }

        @keyframes pulseIcon {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.15); }
        }

        .affiliate-code {
            font-family: 'Outfit', monospace, sans-serif;
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--neon-blue);
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(0, 136, 255, 0.35);
        }

        body.dark-mode .affiliate-code {
            color: var(--neon-blue);
            text-shadow: 0 0 14px rgba(0, 210, 255, 0.7);
        }

        .affiliate-copy-btn {
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple), var(--neon-pink));
            background-size: 200% 200%;
            animation: deepBG 4s ease infinite;
            color: #ffffff;
            border: none;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: 0.78rem;
            font-weight: 800;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 3px 12px rgba(0, 136, 255, 0.35);
            transition: all 0.2s ease;
        }

        .affiliate-copy-btn:hover {
            box-shadow: 0 4px 18px rgba(255, 0, 127, 0.55);
            transform: translateY(-1px);
        }

        .affiliate-copy-btn:active {
            transform: scale(0.92);
        }

        .affiliate-copy-btn i {
            font-size: 0.82rem;
        }

        /* --- SIDEBAR MENU ITEMS --- */
        .menu-list { list-style: none; }

        .menu-item {
            position: relative;
            padding: 13px 16px;
            border-radius: 14px;
            margin-bottom: 9px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--menu-item-color);
            transition: 0.25s ease;
            z-index: 1;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .menu-item::before {
            content: '';
            position: absolute;
            inset: -1.5px;
            border-radius: 15.5px;
            background: linear-gradient(0deg, var(--neon-blue), var(--neon-purple), var(--neon-pink), var(--neon-blue));
            background-size: 300% 300%;
            animation: rotateProfileBorder 4s linear infinite;
            z-index: -2;
            box-shadow: 0 0 6px rgba(0, 210, 255, 0.22);
        }

        .menu-item::after {
            content: '';
            position: absolute;
            inset: 0.5px;
            border-radius: 13.5px;
            background: var(--profile-inner-bg);
            z-index: -1;
            transition: background 0.3s ease;
        }

        .menu-item i:first-child {
            width: 24px;
            text-align: center;
            font-size: 1.22rem;
            flex-shrink: 0;
            z-index: 2;
        }

        .menu-text {
            flex: 1;
            letter-spacing: 0.2px;
            z-index: 2;
        }

        .menu-arrow {
            margin-left: auto;
            font-size: 0.95rem;
            color: var(--menu-arrow-color);
            opacity: 0.75;
            transition: transform 0.2s ease, opacity 0.2s ease, color 0.2s ease;
            flex-shrink: 0;
            z-index: 2;
        }

        .menu-item:hover, .menu-item.active-menu {
            color: var(--neon-blue);
            transform: translateX(4px);
        }

        .menu-item:hover::after, .menu-item.active-menu::after {
            background: linear-gradient(rgba(0, 136, 255, 0.12), rgba(0, 136, 255, 0.12)), var(--profile-inner-bg);
        }

        .menu-item:hover .menu-arrow,
        .menu-item.active-menu .menu-arrow {
            transform: translateX(4px);
            opacity: 1;
            color: var(--neon-blue);
        }

        .logout-btn {
            margin-top: 15px;
            background: linear-gradient(135deg, #ef4444, #991b1b);
            color: white; padding: 14px;
            text-align: center; border-radius: 12px;
            font-weight: 800; cursor: pointer;
            font-size: 1.05rem;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);
        }

        /* --- Full Screen Views & Modals --- */
        .sub-screen {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: var(--subscreen-bg);
            z-index: 2000;
            display: none;
            flex-direction: column;
            padding: 20px 15px 100px 15px;
            overflow-y: auto;
            animation: fadeIn 0.25s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.98); }
            to { opacity: 1; transform: scale(1); }
        }

        .sub-screen-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--card-border);
        }

        .back-btn {
            width: 40px; height: 40px;
            border-radius: 12px;
            background: var(--back-btn-bg);
            border: 1px solid var(--back-btn-border);
            color: var(--back-btn-color);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; font-size: 1.1rem;
            transition: 0.2s;
        }

        .back-btn:active { transform: scale(0.92); }

        .screen-heading {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .app-glass-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 20px;
            margin-bottom: 18px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        }

        .app-gradient-card {
            border-radius: 20px;
            padding: 1.5px;
            background: linear-gradient(135deg, var(--neon-blue), var(--neon-purple), var(--neon-pink));
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .app-gradient-inner {
            background: var(--profile-inner-bg);
            border-radius: 18.5px;
            padding: 22px;
        }

        .card-stat-title {
            font-size: 0.82rem;
            color: var(--text-sub);
            margin-bottom: 6px;
        }

        .card-stat-value {
            font-size: 1.8rem;
            font-weight: 900;
            color: var(--text-main);
            letter-spacing: 0.5px;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-top: 15px;
        }

        .quick-action-btn {
            background: var(--quick-btn-bg);
            border: 1px solid var(--quick-btn-border);
            border-radius: 14px;
            padding: 14px;
            text-align: center;
            cursor: pointer;
            transition: 0.2s;
            color: var(--quick-btn-color);
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .quick-action-btn i {
            font-size: 1.4rem;
            color: var(--neon-blue);
        }

        .quick-action-btn:active {
            transform: scale(0.95);
            background: rgba(0, 136, 255, 0.12);
        }

        .shop-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .shop-item-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        }

        .shop-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(255, 0, 127, 0.12);
            border: 1px solid rgba(255, 0, 127, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
