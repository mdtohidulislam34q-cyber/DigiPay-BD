        /* --- Fixed Toast --- */
        .toast {
            position: fixed;
            bottom: 95px; left: 50%;
            transform: translateX(-50%) translateY(50px);
            background: #10b981; color: white;
            padding: 10px 20px; border-radius: 30px;
            font-size: 0.85rem; font-weight: bold;
