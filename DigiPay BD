                <button class="gateway-close-btn ripple" onclick="closePaymentGateway()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Warning message when unverified user tries to access tasks/services -->
            <div id="gateway-alert-msg" class="gateway-alert-box">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span id="gateway-alert-text">কাজ শুরু করার জন্য প্রথমে একাউন্ট ভেরিফাই সম্পন্ন করুন!</span>
            </div>

            <div class="gateway-body">
                <div class="gateway-plan-box">
                    <div class="gateway-plan-info">
                        <div class="gateway-plan-tag"><i class="fa-solid fa-shield-halved"></i> একাউন্ট অ্যাক্টিভেশন</div>
                        <div class="gateway-plan-name">লাইফটাইম মেম্বারশিপ ভেরিফিকেশন</div>
                    </div>
                    <div class="gateway-amount-wrap">
                        <span class="currency">৳</span>
                        <span class="amount">৫০</span>
                    </div>
                </div>

                <div class="gateway-methods-row">
                    <span class="method-badge bKash">bKash</span>
                    <span class="method-badge nagad">Nagad</span>
                    <span class="method-badge rocket">Rocket</span>
                    <span class="method-badge upay">Upay</span>
                </div>

                <div class="gateway-info-list">
                    <div class="gateway-info-item">
                        <i class="fa-solid fa-circle-check" style="color:#10b981;"></i>
                        <span>অটো পেমেন্ট গেটওয়ে দ্বারা তৎক্ষণাৎ ভেরিফাই</span>
                    </div>
                    <div class="gateway-info-item">
                        <i class="fa-solid fa-circle-check" style="color:#10b981;"></i>
                        <span>সকল সার্ভিস ও ইনকাম কাজের সুযোগ আনলক</span>
                    </div>
                    <div class="gateway-info-item" style="font-size:0.75rem; color:var(--text-sub);">
                        <i class="fa-solid fa-key" style="color:var(--neon-blue);"></i>
                        <span>Brand Key: <code style="font-size:0.72rem; color:var(--neon-blue);">CfQF71uNv7...EKMJ</code></span>
                    </div>
                </div>

                <!-- Main Auto Payment Button (Directs to RupantorPay Link) -->
                <button class="gateway-primary-btn ripple" onclick="proceedToAutoPayment()">
                    <i class="fa-solid fa-shield-check"></i>
                    <span>অটো পেমেন্ট করুন (৳ ৫০)</span>
                </button>

                <!-- TrxID / Instant Confirmation Section -->
                <div class="gateway-verify-section">
                    <div class="gateway-divider">
                        <span>পেমেন্ট শেষ হলে ভেরিফাই নিশ্চিত করুন</span>
                    </div>
                    <div class="gateway-input-group">
                        <input type="text" id="trx-id-input" class="gateway-input" placeholder="TrxID দিন (যেমন: 9J3K8L2M)">
                        <button class="gateway-confirm-btn ripple" onclick="verifyAccountManual()">
                            <i class="fa-solid fa-check"></i> ভেরিফাই
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast">রেফারেল লিংক কপি হয়েছে!</div>

    <script>
        // =======================================================
        // --- PAYMENT GATEWAY CONFIGURATION ---
        // =======================================================
        const PAYMENT_GATEWAY_CONFIG = {
            brandKey: 'CfQF71uNv7muyRoZa2oLZql4KqZZ26S6jgdPfC2Ia38pleEKMJ',
            paymentLink: 'https://rupantorpay.com',
            fee: '50'
        };

        // Check if account is verified
        function isAccountVerified() {
            return localStorage.getItem('digipay_verified') === 'true';
        }

        // Open Payment Gateway Modal
        function openPaymentGatewayModal(alertMessage) {
            const modal = document.getElementById('payment-gateway-modal');
            const alertBox = document.getElementById('gateway-alert-msg');
            const alertText = document.getElementById('gateway-alert-text');

            if (alertMessage) {
                alertText.innerText = alertMessage;
                alertBox.style.display = 'flex';
            } else {
                alertBox.style.display = 'none';
            }

            modal.style.display = 'flex';
        }

        // Close Payment Gateway Modal
        function closePaymentGateway(event) {
            if (event && event.target && event.target.id !== 'payment-gateway-modal' && !event.target.closest('.gateway-close-btn')) {
                return;
            }
            const modal = document.getElementById('payment-gateway-modal');
            modal.style.display = 'none';
        }

        // Proceed to RupantorPay Auto Payment Link
        function proceedToAutoPayment() {
            showToast('অটো পেমেন্ট গেটওয়েতে নিয়ে যাওয়া হচ্ছে...');
            window.open(PAYMENT_GATEWAY_CONFIG.paymentLink, '_blank');
        }

        // Manual or Instant TrxID Verification Confirmation
        function verifyAccountManual() {
            const trxInput = document.getElementById('trx-id-input');
            const trxId = trxInput ? trxInput.value.trim() : '';

            if (trxId.length > 0 && trxId.length < 4) {
                showToast('দয়া করে সঠিক ট্রানজেকশন আইডি (TrxID) দিন');
                return;
            }

            localStorage.setItem('digipay_verified', 'true');
            updateVerificationUI();
            closePaymentGateway();
            showToast('অভিনন্দন! আপনার একাউন্ট সফলভাবে ভেরিফাই হয়েছে।');

            if (trxInput) trxInput.value = '';
        }

        // Check automatic return callback from payment gateway in URL
        function checkPaymentCallback() {
            const params = new URLSearchParams(window.location.search);
            const status = params.get('status') || params.get('payment') || params.get('payment_status');
            const trx = params.get('trx_id') || params.get('transaction_id') || params.get('trxId');
            const verifiedParam = params.get('verified');

            if (status === 'success' || status === 'COMPLETED' || verifiedParam === 'true' || (trx && status !== 'failed' && status !== 'cancel')) {
                localStorage.setItem('digipay_verified', 'true');
                showToast('অভিনন্দন! আপনার পেমেন্ট সফল হয়েছে এবং একাউন্ট ভেরিফাইড!');
                try {
                    window.history.replaceState({}, document.title, window.location.pathname);
                } catch(e) {}
            }
        }

        // Update UI based on verification status
        function updateVerificationUI() {
            const verified = isAccountVerified();
            const dashboardVerifyCard = document.getElementById('dashboard-verify-card');
            const avatarStatus = document.getElementById('profile-avatar-status');
            const sparkleWrap = document.getElementById('profile-sparkle-wrap');
            const roleBadge = document.getElementById('profile-role-badge');
            const roleText = document.getElementById('profile-role-text');
            const roleIcon = document.getElementById('profile-role-icon');

            // ১. ভেরিফাই করার পর ড্যাশবোর্ড এ ভেরিফিকেশন এর কোনো চিহ্ন দেখাবে না
            if (dashboardVerifyCard) {
                dashboardVerifyCard.style.display = verified ? 'none' : 'block';
            }

            // ২. ভেরিফাই করার আগে প্রোফাইল এ ক্রস থাকবে, ভেরিফাই করার পর ঠিক চিহ্ন দেখাবে
            if (avatarStatus) {
                if (verified) {
                    avatarStatus.className = 'avatar-verified-dot';
                    avatarStatus.title = 'ভেরিফাইড একাউন্ট';
                    avatarStatus.innerHTML = '<i class="fa-solid fa-check"></i>';
                } else {
                    avatarStatus.className = 'avatar-verified-dot unverified';
                    avatarStatus.title = 'আনভেরিফাইড একাউন্ট';
                    avatarStatus.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                }
            }

            if (sparkleWrap) {
                if (verified) {
                    sparkleWrap.innerHTML = '<i class="fa-solid fa-certificate name-sparkle" title="ভেরিফাইড"></i>';
                } else {
                    sparkleWrap.innerHTML = '<i class="fa-solid fa-circle-xmark" style="color:#ef4444; font-size:0.9rem;" title="আনভেরিফাইড"></i>';
                }
            }

            if (roleBadge && roleText && roleIcon) {
                if (verified) {
                    roleBadge.style.background = 'linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(0, 136, 255, 0.12))';
                    roleBadge.style.color = '#10b981';
                    roleBadge.style.borderColor = 'rgba(16, 185, 129, 0.35)';
                    roleBadge.style.boxShadow = '0 0 10px rgba(16, 185, 129, 0.2)';
                    roleIcon.className = 'fa-solid fa-gem';
                    roleText.innerText = 'প্রিমিয়াম ভিআইপি মেম্বার';
                } else {
                    roleBadge.style.background = 'rgba(239, 68, 68, 0.12)';
                    roleBadge.style.color = '#ef4444';
                    roleBadge.style.borderColor = 'rgba(239, 68, 68, 0.35)';
                    roleBadge.style.boxShadow = '0 0 10px rgba(239, 68, 68, 0.2)';
                    roleIcon.className = 'fa-solid fa-triangle-exclamation';
                    roleText.innerText = 'সাধারণ মেম্বার (আনভেরিফাইড)';
                }
            }
        }

        // ৩. ভেরিফাই করার আগে কোনো কাজ করতে পারবে না, ভেরিফাই করার পর কাজ করতে পারবে
        function requireVerifiedAction(action) {
            if (!isAccountVerified()) {
                openPaymentGatewayModal('কাজ করতে হলে একাউন্ট ভেরিফাই করতে হবে। অটো পেমেন্ট গেটওয়ের মাধ্যমে ৫০ টাকা ফি দিয়ে ভেরিফাই সম্পন্ন করুন।');
                return;
            }
            if (typeof action === 'function') {
                action();
            } else if (typeof action === 'string') {
                showToast(action);
            }
        }

        // Theme Toggle Logic (Default: Light Mode)
        function toggleTheme() {
            const isDark = document.body.classList.toggle('dark-mode');
            const themeIcon = document.getElementById('theme-icon');
            if (isDark) {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
                localStorage.setItem('digipay_theme', 'dark');
                showToast('ডার্ক মোড সক্রিয় করা হয়েছে');
            } else {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
                localStorage.setItem('digipay_theme', 'light');
                showToast('লাইট মোড সক্রিয় করা হয়েছে');
            }
        }

        // Initialize Theme & Verification on Load
        window.addEventListener('DOMContentLoaded', () => {
            const savedTheme = localStorage.getItem('digipay_theme');
            const themeIcon = document.getElementById('theme-icon');
            if (savedTheme === 'dark') {
                document.body.classList.add('dark-mode');
                if (themeIcon) {
                    themeIcon.classList.remove('fa-moon');
                    themeIcon.classList.add('fa-sun');
                }
            } else {
                document.body.classList.remove('dark-mode');
                if (themeIcon) {
                    themeIcon.classList.remove('fa-sun');
                    themeIcon.classList.add('fa-moon');
                }
            }

            checkPaymentCallback();
            updateVerificationUI();
        });

        // Tab switching logic for Footer
        function switchNavTab(tabName) {
            closeServiceScreen();

            const subScreens = document.querySelectorAll('.sub-screen');
            subScreens.forEach(screen => screen.style.display = 'none');

            const navItems = document.querySelectorAll('.bottom-nav .nav-item');
            navItems.forEach(item => item.classList.remove('active'));

            if (tabName === 'dashboard') {
                document.getElementById('nav-dashboard').classList.add('active');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } else if (tabName === 'agent') {
                document.getElementById('nav-agent').classList.add('active');
                document.getElementById('screen-agent').style.display = 'flex';
            } else if (tabName === 'shop') {
                document.getElementById('nav-shop').classList.add('active');
                document.getElementById('screen-shop').style.display = 'flex';
            } else if (tabName === 'wallet') {
                document.getElementById('nav-wallet').classList.add('active');
                document.getElementById('screen-wallet').style.display = 'flex';
            } else if (tabName === 'network') {
                document.getElementById('nav-network').classList.add('active');
                document.getElementById('screen-network').style.display = 'flex';
            }
        }

        // Open Service Screen with strict verification check
        function openServiceScreen(serviceName) {
            if (!isAccountVerified()) {
                openPaymentGatewayModal('কাজ করতে হলে একাউন্ট ভেরিফাই করতে হবে। অটো পেমেন্ট গেটওয়ের মাধ্যমে ৫০ টাকা ফি দিয়ে ভেরিফাই সম্পন্ন করুন।');
                return;
            }

            const subScreens = document.querySelectorAll('.sub-screen');
            subScreens.forEach(screen => screen.style.display = 'none');

            document.getElementById('screen-title').innerText = serviceName;
            document.getElementById('service-screen').style.display = 'flex';
        }

        function closeServiceScreen() {
            document.getElementById('service-screen').style.display = 'none';
        }

        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.innerText = message;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }

        function openExternalLink(url) {
            window.open(url, '_blank');
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebar-overlay');
            sidebar.classList.toggle('active');
            overlay.style.display = sidebar.classList.contains('active') ? 'block' : 'none';
        }

        function handleLogout() {
            if (confirm("আপনি কি নিশ্চিত যে আপনি লগ আউট করতে চান?")) {
                showToast("সফলভাবে লগ আউট করা হয়েছে!");
                setTimeout(() => location.reload(), 1000);
            }
        }

        function copyReferral() {
            const linkText = document.getElementById('ref-link').innerText;
            navigator.clipboard.writeText(linkText).then(() => {
                showToast("রেফারেল লিংক কপি হয়েছে!");
            }).catch(() => {
                showToast("লিংক কপি সম্পন্ন হয়েছে!");
            });
        }

        // Copy Affiliate ID Function
        function copyAffiliateId() {
            const affiliateId = document.getElementById('affiliate-id-val').innerText.trim();
            const copyIcon = document.getElementById('copy-affiliate-icon');

            navigator.clipboard.writeText(affiliateId).then(() => {
                showToast("অ্যাফিলিয়েট আইডি কপি হয়েছে: " + affiliateId);
                if (copyIcon) {
                    copyIcon.classList.remove('fa-copy', 'fa-regular');
                    copyIcon.classList.add('fa-check', 'fa-solid');
                    setTimeout(() => {
                        copyIcon.classList.remove('fa-check', 'fa-solid');
                        copyIcon.classList.add('fa-copy', 'fa-regular');
                    }, 2000);
                }
            }).catch(() => {
                const tempInput = document.createElement('input');
                tempInput.value = affiliateId;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                showToast("অ্যাফিলিয়েট আইডি কপি হয়েছে: " + affiliateId);
                if (copyIcon) {
                    copyIcon.classList.remove('fa-copy', 'fa-regular');
                    copyIcon.classList.add('fa-check', 'fa-solid');
                    setTimeout(() => {
                        copyIcon.classList.remove('fa-check', 'fa-solid');
                        copyIcon.classList.add('fa-copy', 'fa-regular');
                    }, 2000);
                }
            });
        }

        // Ripple Effect
        document.querySelectorAll('.ripple').forEach(button => {
            button.addEventListener('click', function (e) {
                const rect = this.getBoundingClientRect();
                const circle = document.createElement('span');
                const diameter = Math.max(rect.width, rect.height);
                const radius = diameter / 2;

                circle.style.width = circle.style.height = `${diameter}px`;
                circle.style.left = `${e.clientX - rect.left - radius}px`;
                circle.style.top = `${e.clientY - rect.top - radius}px`;
                circle.classList.add('ripple-effect');

                const existingRipple = this.querySelector('.ripple-effect');
                if (existingRipple) { existingRipple.remove(); }

                this.appendChild(circle);
            });
        });
    </script>
</body>
</html>
